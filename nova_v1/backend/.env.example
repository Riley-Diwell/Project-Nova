# Copy to `.env` and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API Keys -> Secret keys
#   V1 project under team email / password

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Persona embeddings run locally (fastembed + BAAI/bge-large-en-v1.5).