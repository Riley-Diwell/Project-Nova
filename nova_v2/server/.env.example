# Copy to server/.env for local runs. Never commit .env.
# Deployed (deploy/compose.yml), deploy/gen-keys.sh writes these instead.

# Supabase: Dashboard -> Project Settings -> API Keys.
# V2 project: https://bnxjyliakmtfzgwknrdh.supabase.co (V1 is ieezniwxisrjtwovqnhi - not this)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=     # secret / service_role key - server only
SUPABASE_ANON_KEY=        # publishable / anon key - used only to call Supabase Auth
# SUPABASE_JWT_SECRET=    # self-hosted Supabase only (HS256); leave unset on Supabase Cloud

# The model: any OpenAI-compatible chat-completions server (core/llm.py).
# Deployed, this is the Qwen container in deploy/compose.yml.
LLM_BASE_URL=http://127.0.0.1:18020/v1
LLM_API_KEY=              # blank for a server with no key
LLM_MODEL=qwen3.8-27b
SEARXNG_URL=              # web_search; blank = the tool reports it's unavailable
google_maps_api_key=
NOVA_API_KEY=             # the client key the app sends as X-Nova-Api-Key; unset = open (local only)

# NOVA_AUTH_DISABLED=1    # local only: every request is NOVA_DEV_USER_ID, no token needed
# NOVA_MOCK_LLM=1         # local only: no model calls
# NOVA_PRODUCTION=1       # set by the deployment: refuses to start open or with auth disabled
