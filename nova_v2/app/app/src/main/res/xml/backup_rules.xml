<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for API 23-30 (API 31+ uses data_extraction_rules.xml, keep the two in
     step). Personal data stays off Google's backup:
     - nova.db: chat history and reminders (Room, plus its WAL files)
     - nova_auth.xml: the encrypted session. Its Keystore key doesn't survive a restore, so a
       restored copy couldn't be decrypted anyway. -->
<full-backup-content>
    <exclude domain="database" path="nova.db" />
    <exclude domain="database" path="nova.db-shm" />
    <exclude domain="database" path="nova.db-wal" />
    <exclude domain="sharedpref" path="nova_auth.xml" />
</full-backup-content>
