<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for API 31+ (API 23-30 uses backup_rules.xml, keep the
     two in step). See backup_rules.xml for why these files are excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="nova.db" />
        <exclude domain="database" path="nova.db-shm" />
        <exclude domain="database" path="nova.db-wal" />
        <exclude domain="database" path="nova_notes.db" />
        <exclude domain="database" path="nova_notes.db-shm" />
        <exclude domain="database" path="nova_notes.db-wal" />
        <exclude domain="sharedpref" path="nova_auth.xml" />
    </cloud-backup>
    <!-- A direct phone-to-phone move, not Google's cloud, so chat, reminders and notes come along.
         Only the session stays behind: its Keystore key can't move with it. -->
    <device-transfer>
        <exclude domain="sharedpref" path="nova_auth.xml" />
    </device-transfer>
</data-extraction-rules>
