<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Normal protection level, granted at install with no runtime prompt. Required for
         AlarmClock's EXTRA_SKIP_UI to actually skip the Clock app's confirmation screen when
         AlarmIntents.kt fires set_timer/set_alarm - without it the OS shows the screen anyway. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovaV2"
        android:usesCleartextTraffic="true">
        <!-- Cleartext HTTP is only for the local-dev FastAPI backend (nova_v2/server has no
             deployed HTTPS URL yet - see network/NovaApiClient.kt); remove once it does. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NovaV2"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- No ACTION_ASSIST filter here on purpose - AssistTrampolineActivity is the real
                 assist target (see below) so the gesture never has to draw MainActivity's normal
                 UI at all. It only reaches MainActivity, explicitly and with this same action,
                 as the trampoline's fallback when it can't listen headlessly (see
                 AssistTrampolineActivity and onNewIntent() below) - singleTask above keeps that
                 fallback from stacking a second instance if Nova is already running. -->
        </activity>

        <!-- The phone's actual "Digital assistant app" target (Settings > Apps > Default apps).
             Theme.Transparent + noHistory: it never draws a visible frame, it just decides
             whether AssistVoiceService can listen headlessly or MainActivity needs to open as a
             fallback - see AssistTrampolineActivity.kt. taskAffinity="" is load-bearing: without
             it, this defaults to the same affinity as MainActivity (same app, no override), so
             if a MainActivity instance is already resident the system places this activity in
             MainActivity's own task instead of a fresh one - finish() then reveals MainActivity
             sitting right underneath it, which looks exactly like "the app opened" even though
             nothing here ever asked for that. -->
        <activity
            android:name=".AssistTrampolineActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".state.ActivityTransitionReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.DepartureAlarmReceiver"
            android:exported="false" />

        <service
            android:name=".service.SignalMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.AssistVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
