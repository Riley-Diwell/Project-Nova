<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Place reminders ("when I get to the shops") fire from geofences while the app is closed,
         which needs "Allow all the time". Android grants it only from Settings, so it is asked for
         from the Reminders screen when a place reminder exists (state/GeofenceRegistrar.kt). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets BootCompletedReceiver bring NovaDeviceService's BLE connection back after a
         reboot without the user having to open the app first. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Normal protection level, granted at install with no runtime prompt. Required for
         AlarmClock's EXTRA_SKIP_UI to actually skip the Clock app's confirmation screen when
         AlarmIntents.kt fires set_timer/set_alarm - without it the OS shows the screen anyway. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Reminders fire on an exact alarm (state/ReminderScheduler.kt). USE_EXACT_ALARM (API 33+)
         is granted at install and can't be revoked; Google Play limits it to alarm/calendar-type
         apps, which is fine for a sideloaded capstone (a Play release would need to
         revisit it). SCHEDULE_EXACT_ALARM covers API 31-32, where the user can
         revoke it - ReminderScheduler then falls back to an inexact alarm and the Reminders
         screen says so. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- ReminderSpeechService on API 34+ (headphone TTS for a reminder). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />

    <!-- Nova device BLE connection (see ble/ package, docs/ble-protocol.md).
         Legacy pair for API <=30; BLUETOOTH_SCAN/CONNECT replace them from 31.
         neverForLocation on the scan permission: CompanionDeviceManager's own
         picker does the scanning, our filter is only a service UUID, never
         used to derive location - so ACCESS_FINE_LOCATION is not needed. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />

    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <application
        android:name=".NovaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovaV2">
        <!-- No cleartext HTTP: BASE_URL is HTTPS. Debug builds allow it only for the emulator's
             host loopback (src/debug/res/xml/network_security_config.xml). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NovaV2"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- No ACTION_ASSIST filter here on purpose - AssistTrampolineActivity is the real
                 assist target (see below) so the gesture never has to draw MainActivity's normal
                 UI at all. It only reaches MainActivity, explicitly and with this same action,
                 as the trampoline's fallback when it can't listen headlessly (see
                 AssistTrampolineActivity and onNewIntent() below) - singleTask above keeps that
                 fallback from stacking a second instance if Nova is already running. -->
        </activity>

        <!-- The phone's actual "Digital assistant app" target (Settings > Apps > Default apps).
             Theme.Transparent + noHistory: it never draws a visible frame, it just decides
             whether AssistVoiceService can listen headlessly or MainActivity needs to open as a
             fallback - see AssistTrampolineActivity.kt. taskAffinity="" is load-bearing: without
             it, this defaults to the same affinity as MainActivity (same app, no override), so
             if a MainActivity instance is already resident the system places this activity in
             MainActivity's own task instead of a fresh one - finish() then reveals MainActivity
             sitting right underneath it, which looks exactly like "the app opened" even though
             nothing here ever asked for that. -->
        <activity
            android:name=".AssistTrampolineActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Google Maps -> Share -> "Nova compass": points the device's compass at the shared
             place (ShareDestinationActivity). Maps offers no way to read where it is navigating
             to, so sharing is how the user tells Nova. Invisible and gone in a second, like the
             assist trampoline above - taskAffinity="" for the same reason. -->
        <activity
            android:name=".ShareDestinationActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/share_destination_label"
            android:theme="@style/Theme.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".state.ActivityTransitionReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.DepartureAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.ReminderAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.ReminderActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.GeofenceReceiver"
            android:exported="false" />

        <!-- Separate from BootCompletedReceiver, which returns early with no wearable paired -
             reminders must come back after a reboot either way. -->
        <receiver
            android:name=".service.ReminderRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.SignalMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.NovaDeviceService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".service.ReminderSpeechService"
            android:exported="false"
            android:foregroundServiceType="shortService|dataSync" />

        <service
            android:name=".service.AssistVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone|dataSync" />

        <!-- Settings -> Notes -> Export: hands the exported file to the share sheet without
             making it world-readable (NotesSettingsScreen). Only cache/exports/ is exposed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.notes-export"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/notes_export_paths" />
        </provider>
    </application>

</manifest>
